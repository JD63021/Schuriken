FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    p
    {
        AMGsensei
        {
            enabled             true;
            trainSnapshots      3;
            addRank             2;
            maxRank             24;
            recompressRank      16;
            tailIter            10;
            learnOddOnly        1;
        }

        solver          pcgninja;

        preconditioner
        {
            preconditioner GAMG;
            smoother symGaussSeidel;
            nVcycles 1;

            cacheAgglomeration true;
            agglomerator faceAreaPair;
            nCellsInCoarsestLevel 10;
            mergeLevels 1;

            nPreSweeps 0;
            nPostSweeps 2;
            nFinestSweeps 2;
        }

        tolerance            1e-5;
        relTol               0.10;
        maxIter              500;
    }

    pFinal
    {
        solver          pcgninja;

        preconditioner
        {
            preconditioner GAMG;
            smoother symGaussSeidel;
            nVcycles 1;

            cacheAgglomeration true;
            agglomerator faceAreaPair;
            nCellsInCoarsestLevel 10;
            mergeLevels 1;

            nPreSweeps 0;
            nPostSweeps 2;
            nFinestSweeps 2;
        }

        tolerance            1e-5;
        relTol               0;
        maxIter              500;
    }

    U
    {
        solver                  smoothSolver;
        smoother                symGaussSeidel;
        tolerance               1e-8;
        relTol                  0.1;
        nSweeps                 1;
    }

    UFinal
    {
        $U;
        relTol                  0;
    }

    k
    {
        solver                  smoothSolver;
        smoother                symGaussSeidel;
        tolerance               1e-8;
        relTol                  0.1;
        nSweeps                 1;
    }

    kFinal
    {
        $k;
        relTol                  0;
    }

    omega
    {
        solver                  smoothSolver;
        smoother                symGaussSeidel;
        tolerance               1e-8;
        relTol                  0.1;
        nSweeps                 1;
    }

    omegaFinal
    {
        $omega;
        relTol                  0;
    }
}

PIMPLE
{
    // One outer corrector -> steady SIMPLE mode in incompressibleFluid
    nOuterCorrectors            1;
    nCorrectors                 1;
    nNonOrthogonalCorrectors    1;

    momentumPredictor           yes;

    // IMPORTANT: stock SIMPLE, not SIMPLEC
    consistent                  no;

    residualControl
    {
        U                       1e-4;
        k                       1e-4;
        omega                   1e-4;
    }
}

relaxationFactors
{
    fields
    {
        p                    0.70;
    }

    equations
    {
        U                    0.70;
        k                    0.70;
        omega                0.70;
    }
}
